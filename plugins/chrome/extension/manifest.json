{
  "manifest_version": 3,
  "name": "Relay",
  "version": "1.4.0",
  "description": "Your Relay agents and scripts next to every page: ask about the page, a selection or a screenshot, run your scripts, and let agents read and use your tabs, each step allowed by you.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Relay",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "alarms",
    "notifications"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "omnibox": {
    "keyword": "relay"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open Relay's side panel"
    }
  }
}
